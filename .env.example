NEXT_PUBLIC_API_URL=http://localhost:3030/api
# Enable after the backend is configured with Geidea test credentials.
# NEXT_PUBLIC values are bundled at build time; rebuild after changing this flag.
NEXT_PUBLIC_GEIDEA_ENABLED=false

# Canonical public origin used by metadata, social previews and sitemap.
SITE_URL=https://www.digitalbrokerage.sa
# Optional tokens from the owner's verified webmaster accounts (never Google passwords).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
